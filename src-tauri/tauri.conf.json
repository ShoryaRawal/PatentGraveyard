{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GraveTender",
  "version": "0.1.0",
  "identifier": "com.patentgraveyard.gravetender",
  "build": {
    "frontendDist": "../mobile-ui/dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "cd mobile-ui && trunk serve --port 8080 --address 0.0.0.0",
    "beforeBuildCommand": "cd mobile-ui && trunk build --release"
  },
  "app": {
    "windows": [
      {
        "title": "GraveTender",
        "width": 430,
        "height": 900,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http: https:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
