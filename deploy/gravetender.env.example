# /etc/gravetender.env — root:gravetender, mode 0640.
#
# Never put these values in the mobile binary. The phone receives only the
# shared mobile token and the HTTPS base URL.
SERPAPI_KEY=replace-with-serpapi-key
GROQ_API_KEY=replace-with-groq-key
MOBILE_API_TOKEN=replace-with-openssl-rand-hex-32

# Reports persist here; the live patent session is still in memory.
GRAVE_TENDER_DB=/var/lib/gravetender/reports.db

# Caddy proxies to loopback. Use 0.0.0.0:3000 only for temporary LAN testing.
GRAVE_TENDER_ADDR=127.0.0.1:3000
RUST_LOG=info
